[Unit]
Description=Kronos five-session strategy (disabled until platform contract verified)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/large_space_v2/kronos_trading_bot
EnvironmentFile=/home/large_space_v2/kronos_trading_bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/large_space_v2/kronos_trading_bot/.venv/bin/python -m src.main strategy --execute --send
Restart=no
TimeoutStartSec=12h
UMask=0077
